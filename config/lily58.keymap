/*
 * Lily58 ZMK keymap
 *
 * Layers:
 *   0 default_layer (Base)
 *   1 lower_layer   (Lower)
 *   2 raise_layer   (Raise)
 *   3 ultra_layer
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

#define BASE  0
#define LOWER 1
#define RAISE 2
#define ULTRA 3

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BSPC  |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   \   |
            // | SHIFT |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | CTRL  |  Z  |  X  |  C   |  V   |  B   |   [   |   |   ]   |  N   |  M    |  ,    |  .   |   /   | ENTER |
            //                     | ALT  | GUI  | RAISE| SPACE |   | SPACE | LOWER| RAISE | ULTRA |

            bindings = <
&kp ESC     &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                          &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp BSPC
&kp TAB     &kp Q   &kp W   &kp E     &kp R     &kp T                           &kp Y   &kp U   &kp I      &kp O    &kp P     &kp BSLH
&kp LCTRL   &kp A   &kp S   &kp D     &kp F     &kp G                           &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHIFT  &kp Z   &kp X   &kp C     &kp V     &kp B   &kp LBKT     &kp RBKT   &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RET
                            &kp LALT  &kp LGUI  &mo 1   &kp SPACE    &kp SPACE  &mo 2   &mo 1   &mo 3
            >;
        };

        lower_layer {
            display-name = "Lower";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |     |     |      |      |      |                   |      |       |       |  -   |   =   | DEL   |
            // |       |     |     |      |      |      |                   |      |       |  UP   |      |       |       |
            // |       |     |     |      |      |      |                   |      | LEFT  | DOWN  |RIGHT |       |       |
            // |       |     |     |      |      |      |       |   |       |      |       |       |      |       |       |
            //                     |      |      |      |       |   |       |      |       |       |

            bindings = <
&kp GRAVE  &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &kp MINUS  &kp EQUAL  &kp DEL
&trans     &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &kp UP    &trans     &trans     &trans
&trans     &trans  &trans  &trans  &trans  &trans                    &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans     &trans
&trans     &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans    &trans     &trans     &trans
                           &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans
            >;
        };

        raise_layer {
            display-name = "Raise";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   | F1  | F2  | F3   | F4   | F5   |                   | F6   | F7    | F8    | F9   |  F10  | DEL   |
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |       |     |     |      |      |      |  F11  |   |  F12  |      |       |       |      |       |       |
            //                     |      |      |      |       |   |       |      |       |       |

            bindings = <
&kp GRAVE  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                      &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp DEL
&trans     &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans   &trans
&trans     &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans   &trans
&trans     &trans  &trans  &trans  &trans  &trans  &kp F11    &kp F12  &trans  &trans  &trans  &trans  &trans   &trans
                           &trans  &trans  &trans  &trans     &trans   &trans  &trans  &trans
            >;
        };

        ultra_layer {
            display-name = "Ultra";

            // ------------------------------------------------------------------------------------------------------------
            // |BT_CLR |BT_1 |BT_2 | BT_3 | BT_4 |      |                   |      |       |       |      |       |       |
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |       |     |     |      |      |      |       |   |       |      |       |       |      |       |       |
            //                     |      |      |      |       |   |       |      |       |       |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans  &trans  &trans  &trans  &trans  &ext_power EP_TOG
&trans      &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
